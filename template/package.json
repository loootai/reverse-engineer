{
  "name": "looot-app-template",
  "version": "0.1.1",
  "description": "Starter for a small product built on looot: client with quote, cap and idempotency, demo mode, headless CLI with --dry-run, web UI.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "demo": "node scripts/demoGuard.mjs && NEXT_PUBLIC_DEMO=1 next dev -p 3600",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint .",
    "app": "node --conditions=react-server --import tsx src/cli/main.ts",
    "hash-password": "node scripts/hashPassword.mjs",
    "leak-scan": "bash scripts/leak-scan.sh ."
  },
  "dependencies": {
    "geist": "1.7.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
