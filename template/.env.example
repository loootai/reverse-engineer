# looot key for real runs and for the CLI without --dry-run or --demo.
# Create one in looot Settings > Agent tokens, or run `looot login`. Not needed for the demo.
LOOOT_TOKEN=
# Admin password for the web UI. 12 characters or more. Required outside the demo.
# Without it every page and API route except /login and /api/health stays closed.
APP_ADMIN_PASSWORD=
# Alternative to the plain password: the output of `npm run hash-password -- 'your password'`. Wins if both are set.
# APP_ADMIN_PASSWORD_HASH=
# Optional. Key that signs session cookies. Default: derived from the password, so a new password signs everyone out.
# APP_SESSION_SECRET=
# Optional. Set to 0 only to test over plain http in production mode. Leave unset otherwise.
# APP_COOKIE_SECURE=
# Optional. Spend cap in dollars for one run started from the web UI. Default 1, never above 25. The caller cannot change it.
# APP_SPEND_CAP_USD=
# Optional. Overrides the API base, default https://api.looot.ai
# LOOOT_API_URL=
# Optional. Where the web UI and the CLI keep the cost ledger and results. Default .data/state.json
# APP_DATA=
# Optional. Set to 1 to run the web UI on sample data with no token and no network. `npm run demo` sets it.
# NEXT_PUBLIC_DEMO=
